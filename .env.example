# OpenRouter (chat + embeddings). Get a key at https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
OPENROUTER_CHAT_MODEL=openai/gpt-4o
OPENROUTER_MINI_MODEL=openai/gpt-4o-mini
OPENROUTER_APP_NAME=askBack
OPENROUTER_SITE_URL=http://127.0.0.1:3000

# Optional OpenAI key — used only for Whisper voice transcription
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Extra AI providers (optional). Provider priority, first match wins:
# OpenRouter -> Azure OpenAI -> AWS Bedrock -> OpenAI.
# Whisper voice transcription always prefers a real OPENAI_API_KEY above; with
# none set on a non-OpenAI provider, voice notes fall back to a text reply.
# ---------------------------------------------------------------------------

# --- Azure OpenAI (uses your DEPLOYMENT names, not model names) ---
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_MINI_DEPLOYMENT=gpt-4o-mini
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# --- AWS Bedrock (needs: npm install @aws-sdk/client-bedrock-runtime) ---
# Turn it on with AI_PROVIDER=bedrock. Credentials use the standard AWS chain
# (the vars below, shared config, or an instance role).
# AI_PROVIDER=bedrock
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# BEDROCK_CHAT_MODEL=anthropic.claude-3-5-sonnet-20240620-v1:0
# BEDROCK_MINI_MODEL=anthropic.claude-3-haiku-20240307-v1:0
# BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
# BEDROCK_MAX_TOKENS=1024

# Port for the admin panel web server
PORT=3000
HOST=127.0.0.1
BASE_PATH=
PUBLIC_ADMIN=
ADMIN_USER=askback
ADMIN_PASSWORD=changeme
# Require the admin login even on localhost (not just when public). Set to 1/on
# to password-protect the dashboard on a laptop. Needs ADMIN_PASSWORD set.
LOCAL_ADMIN_PASSWORD=

REPEAT_THRESHOLD=0.82
KB_MATCH_THRESHOLD=0.45
TOP_K=3
BOT_MODE=auto
PRIVATE_CHATS=on
MAX_QUESTION_LENGTH=2000

LEMONFOX_API_KEY=
LEMONFOX_VOICE=sarah
LEMONFOX_LANGUAGE=en-us
LEMONFOX_FORMAT=mp3
