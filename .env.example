# OpenAI API key
OPENAI_API_KEY=sk-your-openai-api-key-here

# Admin panel password (used for basic auth)
ADMIN_PASSWORD=changeme

# Port for the admin panel web server
PORT=3000

# Similarity threshold for matching a question to an existing answer (0-1)
# Higher = stricter matching required to reuse a stored answer
REPEAT_THRESHOLD=0.82

# Similarity threshold for matching a question to knowledge base content (0-1)
# Lower = the bot will try to answer from uploaded materials more often
KB_MATCH_THRESHOLD=0.45

# How many knowledge base chunks to send to GPT-4o as context
TOP_K=3

# Bot responder mode: 'auto' answers matched questions only, 'off' disables the bot
BOT_MODE=auto

# Max characters in a question (longer voice transcripts are truncated)
MAX_QUESTION_LENGTH=2000

# Lemonfox TTS — used to reply to incoming voice notes with a voice note
# Get a key at https://www.lemonfox.ai
LEMONFOX_API_KEY=
# Default voice (also selectable in the Knowledge panel)
LEMONFOX_VOICE=sarah
LEMONFOX_LANGUAGE=en-us
LEMONFOX_FORMAT=mp3

# The bot replies in both private chats (@s.whatsapp.net) and groups (@g.us).
# In groups it stays silent when no confident answer is found (to avoid spam).
# In private chats it tells the user when the knowledge base has no match.